# Database URL: SQLite by default, or PostgreSQL in production
# Example PostgreSQL: postgresql+psycopg://user:password@host:5432/budgetbuddy
DATABASE_URL=sqlite:///./budget.db

# Long random string used to sign session cookies and CSRF tokens
# Required in production (APP_ENV=production)
SECRET_KEY=change-me-to-a-long-random-secret-key

# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Set to true to show the "Try the demo" button on the landing page
DEMO_ENABLED=true

# Environment mode: development or production
APP_ENV=development
